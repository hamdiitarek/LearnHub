# Demo or live
#   true  = built-in demo database with seeded courses and one-click demo
#           accounts; DATABASE_URL is ignored
#   false = live, on your PostgreSQL at DATABASE_URL
DEMO_MODE=true

NEXT_PUBLIC_SHOW_REACT_QUERY_DEV_TOOLS=true

# Database URL - Replace with your PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/learnhub?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Optional: OAuth Providers (for future use)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""